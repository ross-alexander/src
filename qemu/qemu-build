sub image_umount {
    my $conf = shift(@_);
    my $opts = {@_};
    
    my $vmname = $conf->{name} || die;
    
    my $dev = $conf->{image}->{device};
    my $fmt = $conf->{image}->{format};
    my $path = $conf->{image}->{path};
    my $mtab = $conf->{image}->{mtab};
    
    for my $n ('esp', 'boot', 'root')
    {
	if ($mtab->{$n} && $mtab->{$n}->{mountpoint})
	{
	    my $mnt = $mtab->{$n}->{mountpoint};
	    if (grep(m:$mnt:, split(m:\n:, slurp('/proc/self/mounts'))))
	    {
		print `umount -v $mnt`;
	    }
	    else
	    {   
		print "$mnt not mounted\n";
	    }
	}
    }

#    sleep(5);

    if ($opts->{qemu})
    {
	qx(udevadm trigger);
	qx(udevadm settle);
	print qx(qemu-nbd -d $dev);
    }
}

# ----------------------------------------------------------------------
#
# mkpart_msdos
#
# ----------------------------------------------------------------------

sub mkpart_msdos {
    my ($nbd, $image) = @_;

    my $partition = $image->{partition};
    my $partitions = $partition->{partitions};
    my $image_size_bytes = parse_bytes($image->{size});
    
    print qx(parted -j -s $nbd mklabel msdos);
    print qx(parted -j -s $nbd unit B print);

    if (!(ref($partitions) eq "ARRAY"))
    {
	printf(STDERR "Partition configuration of msdos must be a list\n");
	return 0;
    }
    
    my $part_total_size = 0;
    my $part_count = 1;
    my $check = 1;
    my @part_mkpart_result;
    
    # --------------------
    # Check settings and sizes
    # --------------------
    
    for my $part (@$partitions)
    {
	my $part_size_bytes = parse_bytes($part->{size});
	if ($part_size_bytes == 0)
	{
	    printf("Partition %d size %s failed to parse\n", $part_count, $part->{size});
	    $check = 0;
	    last;
	}
	my $part_start_bytes = parse_bytes($part->{start});

	if (!defined($part_start_bytes) || ($part_start_bytes == 0))
	{
	    printf("Partition %d start %s failed to parse\n", $part_count, $part->{start} // "[undefined]");
	    $check = 0;
	    last;
	}
	
	# --------------------
	# Type should be primary
	# --------------------
	
	if (!exists($part->{type}))
	{
	    printf("Partition %d missing type\n", $part_count);
	    $check = 0;
	    last;
	}
	$part_total_size += $part_size_bytes;
	if($part_total_size >= $image_size_bytes)
	{
	    printf("Partition %d will exceed disk size (%s vs %s)\n", $part_count,
		   format_bytes($part_total_size), format_bytes($image_size_bytes));
	    $check = 0;
	    last;
	}
	$part_count++;
    }
    
    # --------------------
    # If passed check create partitions
    # --------------------

    return undef if (!$check);

    my $partno = 1;
    for my $part (@$partitions)
    {
	my $start_bytes = parse_bytes($part->{start});
	my $size_bytes = parse_bytes($part->{size});
	my $type = $part->{type};
	my $fstype = $part->{fstype};
	
	my $cmd = sprintf("parted -s $nbd mkpart %s %s %dB %dB", $type, $fstype // "", $start_bytes, $size_bytes);
	print(qx($cmd));
	push(@part_mkpart_result, {partno => $partno, name => $part->{name}, fstype => $fstype, label => $part->{label}, options => $part->{options}});
	$partno += 1;
    }
    return \@part_mkpart_result;
}

# ----------------------------------------------------------------------
#
# mkpart_gpt
#
# ----------------------------------------------------------------------

sub mkpart_gpt {
    my ($nbd, $image) = @_;

    my $partition = $image->{partition};
    my $partitions = $partition->{partitions};
    my $image_size_bytes = parse_bytes($image->{size});

    # --------------------
    # Hack to convert to hash if list
    # --------------------
    
    if (ref($partitions) eq "ARRAY")
    {
	my $part_map_temp = {};
	for my $p (@$partitions)
	{
	    $part_map_temp->{$p->{name}} = $p;
	}
	$partitions = $part_map_temp;
    }
    
    # --------------------
    # Add GPT partition label (for UEFI)
    # --------------------
    
    say(qx(parted -s $nbd mklabel gpt));
	    
    my $parted_details = from_json(qx(parted -j -s $nbd print));
    
    my $block_size = $parted_details->{disk}->{'logical-sector-size'};

    say (to_json($parted_details));
    say (to_json($partitions));

    # --------------------
    # Collect results
    # --------------------

    my @part_mkpart_result;
    
    # --------------------
    # Add EFISYS partition
    # --------------------
    
    my $start_bytes = parse_bytes("1M");
    my $partno = 1;
    if ($partitions->{efisys})
    {
	my $size_efi = $partitions->{efisys}->{size} // "36M";
	my $size_bytes = parse_bytes($size_efi);
	
	printf("%s %s\n", format_bytes($start_bytes), format_bytes($size_bytes));
	
	my $mkpart_efi = sprintf("parted -s $nbd mkpart EFISYS %dB %dB", $start_bytes, $start_bytes + $size_bytes - $block_size);
	
	say($mkpart_efi);
	
	print qx($mkpart_efi);
	print qx(parted -s $nbd set 1 esp);
	
	$start_bytes += $size_bytes;
	push(@part_mkpart_result, {partno => $partno, name => "efisys", fstype => "fat", options => "-F 32 -n EFISYS"});
	$partno += 1;
    }
    
    # --------------------
    # Add boot partition
    # --------------------
    
    if ($partitions->{boot})
    {
	my $size_bytes = parse_bytes($partition->{boot}->{size} // "128M");
	
	printf("%s %s\n", format_bytes($start_bytes), format_bytes($size_bytes));
	
	my $mkpart_boot = sprintf("parted -s $nbd mkpart boot %dB %dB", $start_bytes, $start_bytes + $size_bytes - $block_size);
	$start_bytes += $size_bytes;
	
	say($mkpart_boot);
	print qx($mkpart_boot);
	
	my $label = $partition->{boot}->{label} // "/boot";
	my $options = "-L $label";
	
	push(@part_mkpart_result, {partno => $partno, name => "boot", fstype => $partition->{boot}->{fstype} // "ext4", options => $options});
	$partno += 1;
    }
    
    # --------------------
    # Add root partition
    # --------------------
    
    if ($partitions->{root})
    {
	my $size_bytes = parse_bytes($partitions->{root}->{size});
	
	my $mkpart_root = sprintf("parted -s $nbd mkpart root %dB %dB", $start_bytes, $size_bytes - $block_size);
	say($mkpart_root);
	print qx($mkpart_root);
	
	my $label = $partition->{root}->{label} // "/";
	my $options = "-L $label";
	
	push(@part_mkpart_result, {partno => $partno, name => "root", fstype => $partition->{root}->{fstype} // "ext4", options => $options});
    }
    return \@part_mkpart_result;
}    

# ----------------------------------------------------------------------
#
# image_create
#
# ----------------------------------------------------------------------

sub image_create {
    my $vm = shift @_;
    my $opts = {@_};
    
    my $conf = $vm->configuration_get();
    my $fail = 0;
    
# --------------------
# Put everything into a directory
# --------------------

    my $vmname = $conf->{name} || die;
    my $image = $conf->{image} || die;
    my $format = $conf->{image}->{format} || die;
    my $size = $conf->{image}->{size} || die;

    my $size_bytes = parse_bytes($size);
    if ($size_bytes == 0)
    {
	printf(STDERR "Size %s failed to parse\n", $size);
	exit(1);
    }
    printf("Image size is %d bytes\n", $size_bytes);

    my $imagefile = $conf->{image}->{path};
    
    my $basedir = dirname($imagefile);

    # --------------------
    # Create directory if necessary
    # --------------------

    if (! -d $basedir)
    {
	if (!mkdir($basedir))
	{
	    printf(STDERR "mkdir %s failed: %s\n", $basedir, $!);
	    exit(1);
	}
    }

    # --------------------
    # Remove old image file
    # --------------------
    
    if (-f $imagefile)
    {
	print "Removing old $imagefile\n";
	unlink($imagefile);
    }
    
    # --------------------
    # Create img file
    # --------------------
    
    print qx(qemu-img create -f $format $imagefile $size_bytes);
    sync();

    # --------------------
    # use NBD to make image a device
    # --------------------
    
    my $nbd = $conf->{image}->{device}  || die;
    print qx(qemu-nbd -c $nbd -f $format $imagefile);
    sleep(2);
    print qx(sysctl vm.drop_caches=3);
    
    # --------------------
    # Check if partitioning
    # --------------------

    if ($image->{partition})
    {
	my $partition = $image->{partition};

	my $partition_types = {
	    msdos => 1,
	    gpt => 1,
	};

	# --------------------
	# Check type
	# --------------------
	
	if (!exists($partition->{type}))
	{
	    printf(STDERR "Partition configuration missing 'type': legal types are %s\n", join(keys(%$partition_types)));
	    $fail = 1;
	}

	my $part_type = $partition->{type};

	if (!$fail && !exists($partition_types->{$part_type}))
	{
	    printf(STDERR "Unknown partition type %s: legal types are %s\n", $part_type, join(keys(%$partition_types)));
	    $fail = 1;
	}

	if (!$fail && !exists($partition->{partitions}))
	{
	    printf(STDERR "Partition configuration missing 'partitions'.\n");
	    $fail = 1;
	}
	
#	my $partitions = $partition->{partitions};

	my $part_result;

	# --------------------
	# msdos
	# --------------------
	
	if (!$fail && ($part_type eq "msdos"))
	{
	    $part_result = mkpart_msdos($nbd, $image);
	}
	
	# --------------------
	# gpt
	# --------------------
	
	if (!$fail && ($part_type eq "gpt"))
	{
	    $part_result = mkpart_gpt($nbd, $image);
	}
	
	# --------------------
	# Add print result
	# --------------------
	
	print qx(sysctl vm.drop_caches=3);
	sleep(2);

	$fail = 1 if (!defined($part_result));
	
	if ($fail)
	{
	    qx(qemu-nbd -d ${nbd});
	    exit(1);
	}
	
	# --------------------
	# Use partprobe to pick up partitions
	# --------------------
	
	print qx(partprobe -s $nbd);
	print qx(parted -s $nbd print);
    
	# --------------------
	# Check devices exist
	# --------------------

	for my $part (@$part_result)
	{
	    my $dev = sprintf("%sp%d", $nbd, $part->{partno});

	    if (! -b $dev)
	    {
		printf STDERR "NBD device %s [%s] missing.\n", $nbd, $part->{name};
		qx(qemu-nbd -d $nbd);
		exit 1;
	    }
	    else
	    {
		my @mkfs = ("mkfs","-t",$part->{fstype});
		push(@mkfs, "-L", $part->{label}) if ($part->{label});
		push(@mkfs, $dev);
		my $mkfs = join(" ", @mkfs);
		print qx($mkfs);
	    }
	}
    }

    # --------------------
    # No partition, filesystem directly on block device
    # --------------------
    
    if (!$image->{partition})
    {
	my $fstype = $image->{fstype} // "ext4";
	my $label = $image->{label} // "root";
	print qx(mkfs -t $fstype -L $label $nbd);

	# --------------------
	# For some reason sync and fsync don't cut it
	# --------------------

	print qx(sysctl vm.drop_caches=3);
    }

    # --------------------
    # Disconnect nbd
    # --------------------
    
    print qx(qemu-nbd -d $nbd);
    print "\n";
    sleep(2);
}

